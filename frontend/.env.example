# Voz de las alertas (opcional). Sin clave, la app usa la voz del navegador.
# Copia este archivo como .env.local y completa la clave. Nunca subas .env.local a git.
ELEVENLABS_API_KEY=
# Opcional: id de una voz concreta de tu cuenta. Si se deja vacío, se elige una voz en español.
ELEVENLABS_VOICE_ID=

# Base de Supabase actual (visor en Tierra). La clave es la PUBLICABLE (pensada para el navegador), nunca la secreta.
NEXT_PUBLIC_SUPABASE_URL=https://svhrmvmbmhfizeqkfmhe.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base anterior (deshabilitada). Déjalas vacías: el visor del espacio usa datos de ejemplo.
NEXT_PUBLIC_LEGACY_SUPABASE_URL=
NEXT_PUBLIC_LEGACY_SUPABASE_KEY=
