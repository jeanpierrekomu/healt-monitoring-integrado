# Voz de las alertas (opcional). Sin clave, la app usa la voz del navegador.
# Copia este archivo como .env.local y completa la clave. Nunca subas .env.local a git.
ELEVENLABS_API_KEY=
# Opcional: id de una voz concreta de tu cuenta. Si se deja vacío, se elige una voz en español.
ELEVENLABS_VOICE_ID=

# Backend del equipo (Supabase). Con estas dos variables la app muestra la tripulación, las alertas y
# los hallazgos reales; sin ellas usa los datos de ejemplo. La clave es la PUBLICABLE (pensada para el
# navegador), nunca la secreta.
NEXT_PUBLIC_SUPABASE_URL=https://pnehhvnjuhyvyjdxygmk.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=
